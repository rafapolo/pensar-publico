{
  "name": "pensar-publico",
  "version": "1.0.0",
  "scripts": {
    "build": "bun build src/main.js --outfile dist/bundle.js --target browser --minify",
    "postbuild": "cp -r images dist/ && sed 's|dist/bundle\\.js|bundle.js|g' index.html > dist/index.html",
    "dev": "bun build src/main.js --outfile dist/bundle.js --target browser --watch"
  },
  "dependencies": {
    "jquery": "^3.7.1"
  }
}
